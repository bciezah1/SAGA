# How to run the pipeline

./run_pipeline_plink.sh \
full_path_to_geno_data/geno \
full_path_to_pheno_data/pheno_binary.txt \
COV1,COV2,PC1,PC2,PC3 PHENO binary myoutputs


# Explanation

./run_pipeline_plink.sh \				# main script
full_path_to_geno_data/geno  \				# genotype data in plink format	
full_path_to_pheno_data/pheno_binary.txt  \		# pheno file	
COV1,COV2,PC1,PC2,PC3 \					# covariate list (PCs up to 10)
PHENO \							# target variable
binary							# type target variable
myoutputs						# name of your folder where results will be located
